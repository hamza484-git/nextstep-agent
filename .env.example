# Copy to .env and fill in.
# Get a free Gemini key from https://aistudio.google.com/apikey
# Without a key, the agent falls back to the deterministic MockProvider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Force mock provider even if a key is present (useful in CI):
# NEXTSTEP_MOCK=1
